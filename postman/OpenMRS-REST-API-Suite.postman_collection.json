    {
      "name": "TC006b - Find the source UUID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Identifier sources retrieved\", () => pm.response.to.have.status(200));\r",
              "\r",
              "const OPENMRS_ID_TYPE = \"05a29f94-c0ed-11e2-94be-8c13b969e334\";\r",
              "const sources = pm.response.json().results;\r",
              "\r",
              "// Match on identifierType, not on name — names vary between installs\r",
              "const source = sources.find(s => s.identifierType && s.identifierType.uuid === OPENMRS_ID_TYPE);\r",
              "\r",
              "pm.test(\"A generator exists for OpenMRS ID\", () => {\r",
              "  pm.expect(source, \"no source bound to the OpenMRS ID type\").to.not.be.undefined;\r",
              "});\r",
              "\r",
              "if (source) {\r",
              "  pm.environment.set(\"idgenSourceUuid\", source.uuid);\r",
              "  console.log(\"Using source:\", source.name, source.uuid);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/idgen/identifiersource?v=full",
