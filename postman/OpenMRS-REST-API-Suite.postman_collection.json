      "name": "TC015 - Access Protected Resource Without Auth (Negative)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Invalidate the session on the server. Even if Postman still transmits\r",
              "// JSESSIONID, the server no longer recognises it as authenticated.\r",
              "pm.sendRequest({\r",
              "  url: pm.environment.get(\"baseUrl\") + \"/session\",\r",
              "  method: \"DELETE\"\r",
              "}, (err, res) => {\r",
              "  console.log(\"Pre-emptive logout:\", err ? err : res.code);\r",
              "});\r",
              "\r",
              "// Best-effort cookie clear as well (requires domain allowlist)\r",
              "pm.cookies.jar().clear(\"test3.openmrs.org\", (err) => {\r",
              "  console.log(err ? \"Cookie clear blocked: \" + err : \"Cookie jar cleared\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Protected resource rejects unauthenticated request\", () => {\r",
              "  pm.response.to.have.status(401);\r",
              "});\r",
              "\r",
              "pm.test(\"No patient data returned in the rejection\", () => {\r",
              "  pm.expect(pm.response.text()).to.not.include(\"Joshua\");\r",
              "  pm.expect(pm.response.json()).to.not.have.property(\"identifiers\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
