  "item": [
    {
      "name": "TC001 - Session (Health Check)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", function() {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"User is authenticated\", function() {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body.authenticated).to.equal(true);\r",
              "});\r",
              "\r",
              "pm.test(\"System ID is admin\", function() {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body.user.systemId).to.equal('admin');\r",
              "});\r",
              "\r",
              "pm.test(\"Session location is set\", function() {\r",
              "    const body = pm.response.json();\r",
              "    // Structural check only: the session location is ambient server state and\r",
              "    // varies by instance and by whatever ran last. Asserting a specific name\r",
              "    // here made TC001 depend on TC002 having run first.\r",
              "    pm.expect(body.sessionLocation).to.not.be.null;\r",
              "    pm.expect(body.sessionLocation).to.have.property('uuid');\r",
              "    pm.expect(body.sessionLocation.display).to.be.a('string').and.not.be.empty;\r",
              "});\r",
              "\r",
              "pm.test(\"User has roles assigned\", function() {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body.user.roles).to.be.an('array');\r",
              "    pm.expect(body.user.roles.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Current provider exists\", function() {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body.currentProvider).to.not.be.null;\r",
              "});\r",
              "\r",
              "// Auto-save UUIDs for use in later requests\r",
              "const body = pm.response.json();\r",
              "pm.environment.set(\"locationUuid\", body.sessionLocation.uuid);\r",
              "pm.environment.set(\"providerUuid\", body.currentProvider.uuid);\r",
              "pm.environment.set(\"userUuid\", body.user.uuid);\r",
              "pm.test(\"UUIDs saved to environment\", function() {\r",
              "    pm.expect(pm.environment.get(\"locationUuid\")).to.not.be.empty;\r",
              "    pm.expect(pm.environment.get(\"providerUuid\")).to.not.be.empty;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "password",
              "value": "Admin123",
              "type": "string"
