    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "const UA = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36\";",
          "pm.request.headers.upsert({ key: \"User-Agent\", value: UA });",
          "pm.request.headers.upsert({ key: \"Accept\", value: \"application/json\" });",
          "",
          "const baseUrl = pm.environment.get(\"baseUrl\");",
          "pm.sendRequest({",
          "    url: baseUrl + \"/session\",",
          "    method: \"GET\",",
          "    header: { \"User-Agent\": UA, \"Accept\": \"application/json\" },",
          "    auth: { type: \"basic\", basic: [",
          "        { key: \"username\", value: pm.environment.get(\"username\") || \"admin\" },",
          "        { key: \"password\", value: pm.environment.get(\"password\") || \"Admin123\" }",
          "    ]}",
          "}, function (err, response) {",
          "    if (err || !response) { return; }",
          "    try {",
          "        if (response.json().authenticated) { console.log(\"Session refreshed\"); }",
          "    } catch (e) {",
          "        console.log(\"Session refresh returned non-JSON (status \" + response.code + \")\");",
          "    }",
          "});"
        ]
      }
