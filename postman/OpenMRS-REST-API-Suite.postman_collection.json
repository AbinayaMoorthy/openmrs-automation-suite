              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"New patient UUID is returned\", function() {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body).to.have.property('uuid');\r",
              "    pm.expect(body.uuid).to.not.be.empty;\r",
              "});\r",
