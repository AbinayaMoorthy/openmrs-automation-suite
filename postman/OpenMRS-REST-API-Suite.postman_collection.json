    {
      "name": "TC008 - Verify the created patient",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Created patient is retrievable\", () => pm.response.to.have.status(200));\r",
              "\r",
              "const patient = pm.response.json();\r",
              "\r",
              "pm.test(\"UUID matches the one returned by TC007\", () => {\r",
              "  pm.expect(patient.uuid).to.eql(pm.environment.get(\"newPatientUuid\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Identifier persisted matches the generated ID\", () => {\r",
              "  const ids = patient.identifiers.map(i => i.identifier);\r",
              "  pm.expect(ids).to.include(pm.environment.get(\"generatedPatientId\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Preferred identifier is of type OpenMRS ID\", () => {\r",
              "  const preferred = patient.identifiers.find(i => i.preferred);\r",
              "  pm.expect(preferred.identifierType.uuid)\r",
              "    .to.eql(\"05a29f94-c0ed-11e2-94be-8c13b969e334\");\r",
              "});\r",
              "\r",
              "pm.test(\"Name persisted correctly\", () => {\r",
              "  const name = patient.person.preferredName;\r",
              "  pm.expect(name.givenName).to.eql(\"Abinaya\");\r",
              "  pm.expect(name.familyName).to.eql(\"APITest\");\r",
              "});\r",
              "\r",
              "pm.test(\"Demographics persisted correctly\", () => {\r",
              "  pm.expect(patient.person.gender).to.eql(\"F\");\r",
              "  pm.expect(patient.person.birthdate).to.include(\"1995-03-15\");\r",
              "});\r",
              "\r",
              "pm.test(\"Patient is not voided\", () => {\r",
              "  pm.expect(patient.voided).to.be.false;\r",
              "});\r",
              "\r",
              "pm.test(\"Stored identifier satisfies Luhn Mod-30\", () => {\r",
              "  const ALLOWED = \"0123456789ACDEFGHJKLMNPRTUVWXY\";\r",
              "  const full = pm.environment.get(\"generatedPatientId\");\r",
              "  const base = full.slice(0, -1);\r",
              "  let factor = 2, sum = 0;\r",
              "  for (let i = base.length - 1; i >= 0; i--) {\r",
              "    let addend = factor * ALLOWED.indexOf(base.charAt(i));\r",
              "    factor = factor === 2 ? 1 : 2;\r",
              "    sum += Math.floor(addend / 30) + (addend % 30);\r",
              "  }\r",
