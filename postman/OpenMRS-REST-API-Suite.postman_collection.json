    {
      "name": "TC006 - Single Patient by UUID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", function() {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Patient UUID matches requested\", function() {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body.uuid).to.equal(pm.environment.get(\"patientUuid\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Patient has person details\", function() {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body).to.have.property('person');\r",
              "    // Expected name lives in the environment alongside patientUuid, so the\r",
              "    // pair can be repointed at a different instance without editing scripts.\r",
              "    pm.expect(body.person.display).to.equal(pm.environment.get(\"expectedPatientName\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Patient has identifiers\", function() {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body.identifiers).to.be.an('array');\r",
              "    pm.expect(body.identifiers.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Patient is not voided\", function() {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body.voided).to.equal(false);\r",
              "});\r",
              "\r",
              "pm.test(\"Patient gender is correct\", function() {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body.person.gender).to.equal(pm.environment.get(\"expectedPatientGender\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Response time under 5 seconds\", function() {\r",
