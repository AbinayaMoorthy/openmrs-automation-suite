    {
      "name": "TC004 - List Patients (Search Required)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", function() {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response has results array\", function() {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body).to.have.property('results');\r",
              "    pm.expect(body.results).to.be.an('array');\r",
              "});\r",
              "\r",
              "pm.test(\"Results contain patients\", function() {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body.results.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Each patient has UUID\", function() {\r",
              "    const body = pm.response.json();\r",
              "    body.results.forEach(patient => {\r",
              "        pm.expect(patient).to.have.property('uuid');\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Each patient has display name\", function() {\r",
              "    const body = pm.response.json();\r",
              "    body.results.forEach(patient => {\r",
              "        pm.expect(patient).to.have.property('display');\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Response time under 5 seconds\", function() {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
              "});\r",
              "\r",
              "// Save first patient UUID for next requests\r",
              "const firstPatient = pm.response.json().results[0];\r",
              "pm.environment.set(\"patientUuid\", firstPatient.uuid);\r",
              "pm.environment.set(\"patientName\", firstPatient.display);\r",
              "pm.test(\"First patient UUID saved: \" + firstPatient.uuid, function() {\r",
              "    pm.expect(firstPatient.uuid).to.not.be.empty;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
